    "proposal": {
      "summary": "Fix ZeroDivisionError in average() when values list has length 1 by removing the erroneous '-1' from the denominator.",
      "changes": [
        {
          "path": "app.py",
          "find": "def average(values):\n    return sum(values) / (len(values) - 1)",
          "replace": "def average(values):\n    return sum(values) / len(values)",
          "explanation": "The original code subtracts 1 from the count of values before division, causing division by zero when only one value exists. The mean should divide by the actual count of values."
        }
      ],
      "risks": [
        "This change alters the mathematical formula used in the function; however, the hypothesis explicitly identifies this as the cause of the recorded exception.",
        "No other files are modified, and no test code is changed per constraints."
      ]
    },
